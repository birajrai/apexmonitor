<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ApexMonitor Admin</title>
  <link rel="stylesheet" href="https://unpkg.com/light-icons/dist/light-icon.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/admin" class="navbar-brand">
        <i class="light-icon-activity"></i>
        <span>Apex</span>Monitor
      </a>
      <div class="navbar-nav" id="navbarNav">
        <a href="/admin" class="nav-link">
          <i class="light-icon-grid"></i>
          <span>Dashboard</span>
        </a>
        <a href="/admin/incidents" class="nav-link">
          <i class="light-icon-alert-triangle"></i>
          <span>Incidents</span>
        </a>
        <a href="/admin/settings" class="nav-link">
          <i class="light-icon-settings"></i>
          <span>Settings</span>
        </a>
        <a href="/" target="_blank" class="nav-link">
          <i class="light-icon-external-link"></i>
          <span>Status Page</span>
        </a>
        <div class="nav-divider"></div>
        <button class="theme-toggle" id="themeToggle" title="Toggle dark mode">
          <i class="light-icon-moon"></i>
          <i class="light-icon-sun"></i>
        </button>
        <a href="/auth/logout" class="nav-link nav-link-danger">
          <i class="light-icon-log-out"></i>
          <span>Logout</span>
        </a>
      </div>
      <button class="navbar-toggle" id="navbarToggle">
        <i class="light-icon-menu"></i>
      </button>
    </div>
  </nav>

  <div class="container container-md admin-content">
    <div class="page-header">
      <div class="page-header-left">
        <h1>
          <i class="light-icon-<%= service && service._id ? 'edit' : 'plus-circle' %>"></i>
          <%= title %>
        </h1>
        <p class="page-subtitle"><%= service && service._id ? 'Modify service configuration' : 'Configure a new service to monitor' %></p>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">
        <i class="light-icon-alert-circle"></i>
        <%= error %>
      </div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <form action="<%= service && service._id ? '/admin/services/' + service._id : '/admin/services' %>" method="POST">
          
          <!-- Basic Information -->
          <div class="form-section">
            <div class="form-section-title">
              <i class="light-icon-info"></i> Basic Information
            </div>
            
            <div class="form-group">
              <label for="name">
                <i class="light-icon-tag"></i> Service Name <span class="required">*</span>
              </label>
              <input type="text" id="name" name="name" required maxlength="100" 
                value="<%= service ? service.name : '' %>" 
                placeholder="e.g., API Server">
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="group">
                  <i class="light-icon-folder"></i> Group
                </label>
                <input type="text" id="group" name="group" maxlength="50" 
                  value="<%= service ? service.group : 'Default' %>" 
                  placeholder="e.g., Backend">
                <small class="form-help">Group services together on the status page</small>
              </div>

              <div class="form-group">
                <label for="monitorType">
                  <i class="light-icon-link"></i> Monitor Type <span class="required">*</span>
                </label>
                <div class="select-wrapper">
                  <select id="monitorType" name="monitorType" required>
                    <option value="">Select type...</option>
                    <% monitorTypes.forEach(type => { %>
                      <option value="<%= type %>" <%= service && service.monitorType === type ? 'selected' : '' %>>
                        <%= type.toUpperCase() %> - <%= type === 'http' ? 'Web & API' : (type === 'ping' ? 'Network Host' : 'DNS Records') %>
                      </option>
                    <% }) %>
                  </select>
                  <i class="light-icon-chevron-down select-icon"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- HTTP Configuration -->
          <div id="http-config" class="monitor-config">
            <div class="form-section-title">
              <i class="light-icon-globe"></i> HTTP Monitor Configuration
            </div>
            <div class="form-group">
              <label for="httpUrl">
                <i class="light-icon-link"></i> URL <span class="required">*</span>
              </label>
              <div class="input-with-icon">
                <i class="light-icon-globe input-icon"></i>
                <input type="url" id="httpUrl" name="httpUrl" 
                  value="<%= service && service.monitorType === 'http' ? service.monitorConfig.url : '' %>" 
                  placeholder="https://example.com/health">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="httpMethod">
                  <i class="light-icon-repeat"></i> Method
                </label>
                <div class="select-wrapper">
                  <select id="httpMethod" name="httpMethod">
                    <option value="GET" <%= service && service.monitorConfig?.method === 'GET' ? 'selected' : '' %>>GET</option>
                    <option value="POST" <%= service && service.monitorConfig?.method === 'POST' ? 'selected' : '' %>>POST</option>
                    <option value="HEAD" <%= service && service.monitorConfig?.method === 'HEAD' ? 'selected' : '' %>>HEAD</option>
                  </select>
                  <i class="light-icon-chevron-down select-icon"></i>
                </div>
              </div>
              <div class="form-group">
                <label for="httpExpectedStatus">
                  <i class="light-icon-check-square"></i> Expected Status Code
                </label>
                <input type="number" id="httpExpectedStatus" name="httpExpectedStatus" 
                  value="<%= service && service.monitorConfig?.expectedStatusCode ? service.monitorConfig.expectedStatusCode : 200 %>" 
                  min="100" max="599">
              </div>
            </div>
            <div class="form-group">
              <label for="httpTimeout">
                <i class="light-icon-watch"></i> Timeout (ms)
              </label>
              <input type="number" id="httpTimeout" name="httpTimeout" 
                value="<%= service && service.monitorConfig?.timeoutMs ? service.monitorConfig.timeoutMs : 30000 %>" 
                min="1000" max="120000">
              <small class="form-help">Maximum time to wait for a response (default: 30000ms)</small>
            </div>
          </div>

          <!-- Ping Configuration -->
          <div id="ping-config" class="monitor-config">
            <div class="form-section-title">
              <i class="light-icon-wifi"></i> Ping Monitor Configuration
            </div>
            <div class="form-group">
              <label for="pingHost">
                <i class="light-icon-server"></i> Host <span class="required">*</span>
              </label>
              <div class="input-with-icon">
                <i class="light-icon-wifi input-icon"></i>
                <input type="text" id="pingHost" name="pingHost" 
                  value="<%= service && service.monitorType === 'ping' ? service.monitorConfig.host : '' %>" 
                  placeholder="example.com or 192.168.1.1">
              </div>
            </div>
            <div class="form-group">
              <label for="pingTimeout">
                <i class="light-icon-watch"></i> Timeout (ms)
              </label>
              <input type="number" id="pingTimeout" name="pingTimeout" 
                value="<%= service && service.monitorConfig?.timeoutMs ? service.monitorConfig.timeoutMs : 5000 %>" 
                min="1000" max="60000">
              <small class="form-help">Maximum time to wait for ping response (default: 5000ms)</small>
            </div>
          </div>

          <!-- DNS Configuration -->
          <div id="dns-config" class="monitor-config">
            <div class="form-section-title">
              <i class="light-icon-share-2"></i> DNS Monitor Configuration
            </div>
            <div class="form-group">
              <label for="dnsHostname">
                <i class="light-icon-at-sign"></i> Hostname <span class="required">*</span>
              </label>
              <div class="input-with-icon">
                <i class="light-icon-share-2 input-icon"></i>
                <input type="text" id="dnsHostname" name="dnsHostname" 
                  value="<%= service && service.monitorType === 'dns' ? service.monitorConfig.hostname : '' %>" 
                  placeholder="example.com">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="dnsRecordType">
                  <i class="light-icon-list"></i> Record Type
                </label>
                <div class="select-wrapper">
                  <select id="dnsRecordType" name="dnsRecordType">
                    <option value="A" <%= service && service.monitorConfig?.recordType === 'A' ? 'selected' : '' %>>A (IPv4)</option>
                    <option value="AAAA" <%= service && service.monitorConfig?.recordType === 'AAAA' ? 'selected' : '' %>>AAAA (IPv6)</option>
                    <option value="CNAME" <%= service && service.monitorConfig?.recordType === 'CNAME' ? 'selected' : '' %>>CNAME</option>
                    <option value="MX" <%= service && service.monitorConfig?.recordType === 'MX' ? 'selected' : '' %>>MX (Mail)</option>
                    <option value="TXT" <%= service && service.monitorConfig?.recordType === 'TXT' ? 'selected' : '' %>>TXT</option>
                  </select>
                  <i class="light-icon-chevron-down select-icon"></i>
                </div>
              </div>
              <div class="form-group">
                <label for="dnsExpectedValue">
                  <i class="light-icon-check"></i> Expected Value (optional)
                </label>
                <input type="text" id="dnsExpectedValue" name="dnsExpectedValue" 
                  value="<%= service && service.monitorConfig?.expectedValue ? service.monitorConfig.expectedValue : '' %>" 
                  placeholder="e.g., 93.184.216.34">
              </div>
            </div>
          </div>

          <!-- Monitoring Settings -->
          <div class="form-section">
            <div class="form-section-title">
              <i class="light-icon-play-circle"></i> Monitoring Settings
            </div>

            <div class="form-group">
              <div class="toggle-switch-group">
                <label class="toggle-switch">
                  <input type="checkbox" id="isActive" name="isActive" 
                    <%= !service || service.isActive ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <label for="isActive" class="toggle-label">
                  <strong>Active Monitoring</strong>
                  <small>Enable health checks for this service</small>
                </label>
              </div>
            </div>
          </div>

          <!-- Status Page Settings -->
          <div class="form-section">
            <div class="form-section-title">
              <i class="light-icon-monitor"></i> Status Page Settings
            </div>

            <div class="form-group">
              <div class="toggle-switch-group">
                <label class="toggle-switch">
                  <input type="checkbox" id="showOnStatusPage" name="showOnStatusPage" 
                    <%= !service || service.showOnStatusPage ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <label for="showOnStatusPage" class="toggle-label">
                  <strong>Show on Public Status Page</strong>
                  <small>Display this service on the public status page</small>
                </label>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="statusPageLabel">
                  <i class="light-icon-tag"></i> Display Label (optional)
                </label>
                <input type="text" id="statusPageLabel" name="statusPageLabel" maxlength="100"
                  value="<%= service && service.statusPageLabel ? service.statusPageLabel : '' %>" 
                  placeholder="Custom name on status page">
              </div>
              <div class="form-group">
                <label for="statusPageOrder">
                  <i class="light-icon-hash"></i> Display Order
                </label>
                <input type="number" id="statusPageOrder" name="statusPageOrder" 
                  value="<%= service && service.statusPageOrder !== undefined ? service.statusPageOrder : 0 %>" 
                  min="0">
                <small class="form-help">Lower numbers appear first</small>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg">
              <i class="light-icon-<%= service && service._id ? 'save' : 'plus' %>"></i>
              <span><%= service && service._id ? 'Update Service' : 'Create Service' %></span>
            </button>
            <a href="/admin" class="btn btn-secondary btn-lg">
              <i class="light-icon-x"></i>
              <span>Cancel</span>
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="/script.js"></script>
</body>
</html>
