<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ApexMonitor Admin</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/admin" class="navbar-brand"><span>Apex</span>Monitor</a>
      <div class="navbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/incidents">Incidents</a>
        <a href="/admin/settings">Settings</a>
        <a href="/" target="_blank">Status Page</a>
        <a href="/auth/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container admin-content">
    <div class="page-header">
      <h1><%= service.name %> - History</h1>
      <a href="/admin" class="btn btn-secondary">← Back to Dashboard</a>
    </div>

    <div class="card mb-6">
      <div class="info-grid">
        <div class="info-item">
          <label>Group</label>
          <span><%= service.group %></span>
        </div>
        <div class="info-item">
          <label>Monitor Type</label>
          <span><%= service.monitorType.toUpperCase() %></span>
        </div>
        <div class="info-item">
          <label>Status</label>
          <span><%= service.isActive ? 'Active' : 'Inactive' %></span>
        </div>
        <div class="info-item">
          <label>Status Page</label>
          <span><%= service.showOnStatusPage ? 'Visible' : 'Hidden' %></span>
        </div>
      </div>
    </div>

    <div class="card mb-6">
      <div class="card-header">Recent Incidents (<%= incidents.length %>)</div>
      <% if (incidents.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">✓</div>
          <p>No incidents recorded</p>
        </div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Status</th>
                <th>Started</th>
                <th>Resolved</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <% incidents.forEach(incident => { %>
                <tr>
                  <td>
                    <span class="badge <%= incident.resolvedAt ? 'badge-up' : 'badge-down' %>">
                      <%= incident.resolvedAt ? 'Resolved' : 'Active' %>
                    </span>
                  </td>
                  <td><%= incident.startedAt.toLocaleString() %></td>
                  <td><%= incident.resolvedAt ? incident.resolvedAt.toLocaleString() : '-' %></td>
                  <td>
                    <% if (incident.resolvedAt) { %>
                      <% 
                        const duration = incident.resolvedAt - incident.startedAt;
                        const minutes = Math.floor(duration / 60000);
                        const hours = Math.floor(minutes / 60);
                      %>
                      <%= hours > 0 ? hours + 'h ' : '' %><%= minutes % 60 %>m
                    <% } else { %>
                      <span class="text-danger">Ongoing</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="card">
      <div class="card-header">Recent Checks (<%= checks.length %>)</div>
      <% if (checks.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">📊</div>
          <p>No checks recorded yet</p>
        </div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Status</th>
                <th>Response Time</th>
                <th>Checked At</th>
                <th>Error</th>
              </tr>
            </thead>
            <tbody>
              <% checks.forEach(check => { %>
                <tr>
                  <td>
                    <span class="badge badge-<%= check.status.toLowerCase() %>">
                      <%= check.status %>
                    </span>
                  </td>
                  <td><%= check.responseTimeMs %>ms</td>
                  <td><%= check.checkedAt.toLocaleString() %></td>
                  <td>
                    <% if (check.error) { %>
                      <span class="error-text" title="<%= check.error %>"><%= check.error %></span>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <script src="/script.js"></script>
</body>
</html>
