<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ApexMonitor Admin</title>
  <link rel="stylesheet" href="https://unpkg.com/light-icons/dist/light-icon.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/admin" class="navbar-brand">
        <i class="light-icon-activity"></i>
        <span>Apex</span>Monitor
      </a>
      <div class="navbar-nav" id="navbarNav">
        <a href="/admin" class="nav-link">
          <i class="light-icon-grid"></i>
          <span>Dashboard</span>
        </a>
        <a href="/admin/incidents" class="nav-link active">
          <i class="light-icon-alert-triangle"></i>
          <span>Incidents</span>
        </a>
        <a href="/admin/settings" class="nav-link">
          <i class="light-icon-settings"></i>
          <span>Settings</span>
        </a>
        <a href="/" target="_blank" class="nav-link">
          <i class="light-icon-external-link"></i>
          <span>Status Page</span>
        </a>
        <div class="nav-divider"></div>
        <button class="theme-toggle" id="themeToggle" title="Toggle dark mode">
          <i class="light-icon-moon"></i>
          <i class="light-icon-sun"></i>
        </button>
        <a href="/auth/logout" class="nav-link nav-link-danger">
          <i class="light-icon-log-out"></i>
          <span>Logout</span>
        </a>
      </div>
      <button class="navbar-toggle" id="navbarToggle">
        <i class="light-icon-menu"></i>
      </button>
    </div>
  </nav>

  <div class="container admin-content">
    <div class="page-header">
      <div class="page-header-left">
        <h1><i class="light-icon-alert-triangle"></i> Incidents</h1>
        <p class="page-subtitle">View and manage service incidents</p>
      </div>
    </div>

    <div class="card">
      <% if (incidents.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="light-icon-check-circle"></i>
          </div>
          <h3>All Clear!</h3>
          <p>No incidents have been recorded yet</p>
        </div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="incidents-table">
            <thead>
              <tr>
                <th><i class="light-icon-circle"></i> Status</th>
                <th><i class="light-icon-server"></i> Service</th>
                <th><i class="light-icon-play"></i> Started</th>
                <th><i class="light-icon-square"></i> Resolved</th>
                <th><i class="light-icon-clock"></i> Duration</th>
              </tr>
            </thead>
            <tbody>
              <% incidents.forEach(incident => { 
                const service = incident.serviceId;
              %>
                <tr class="incident-row <%= incident.resolvedAt ? 'resolved' : 'active' %>">
                  <td>
                    <span class="status-badge <%= incident.resolvedAt ? 'status-up' : 'status-down' %>">
                      <i class="light-icon-<%= incident.resolvedAt ? 'check-circle' : 'alert-circle' %>"></i>
                      <%= incident.resolvedAt ? 'Resolved' : 'Active' %>
                    </span>
                  </td>
                  <td>
                    <div class="service-name-cell">
                      <i class="light-icon-server service-type-icon"></i>
                      <strong><%= service ? service.name : 'Unknown' %></strong>
                    </div>
                  </td>
                  <td>
                    <span class="datetime">
                      <i class="light-icon-clock"></i>
                      <%= incident.startedAt.toLocaleString() %>
                    </span>
                  </td>
                  <td>
                    <% if (incident.resolvedAt) { %>
                      <span class="datetime">
                        <i class="light-icon-clock"></i>
                        <%= incident.resolvedAt.toLocaleString() %>
                      </span>
                    <% } else { %>
                      <span class="text-muted"><i class="light-icon-minus"></i> -</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (incident.resolvedAt) { %>
                      <% 
                        const duration = incident.resolvedAt - incident.startedAt;
                        const minutes = Math.floor(duration / 60000);
                        const hours = Math.floor(minutes / 60);
                      %>
                      <span class="duration-badge">
                        <i class="light-icon-clock"></i>
                        <%= hours > 0 ? hours + 'h ' : '' %><%= minutes % 60 %>m
                      </span>
                    <% } else { %>
                      <span class="duration-badge active">
                        <i class="light-icon-refresh-cw animate-spin"></i>
                        Ongoing
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <script src="/script.js"></script>
</body>
</html>
