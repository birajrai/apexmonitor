<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ApexMonitor Admin</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/admin" class="navbar-brand"><span>Apex</span>Monitor</a>
      <div class="navbar-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/incidents" class="active">Incidents</a>
        <a href="/admin/settings">Settings</a>
        <a href="/" target="_blank">Status Page</a>
        <a href="/auth/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container admin-content">
    <div class="page-header">
      <h1>Incidents</h1>
    </div>

    <div class="card">
      <% if (incidents.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">✓</div>
          <p>No incidents recorded</p>
        </div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Status</th>
                <th>Service</th>
                <th>Started</th>
                <th>Resolved</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <% incidents.forEach(incident => { 
                const service = incident.serviceId;
              %>
                <tr>
                  <td>
                    <span class="badge <%= incident.resolvedAt ? 'badge-resolved' : 'badge-down' %>">
                      <%= incident.resolvedAt ? 'Resolved' : 'Active' %>
                    </span>
                  </td>
                  <td><strong><%= service ? service.name : 'Unknown' %></strong></td>
                  <td><%= incident.startedAt.toLocaleString() %></td>
                  <td><%= incident.resolvedAt ? incident.resolvedAt.toLocaleString() : '-' %></td>
                  <td>
                    <% if (incident.resolvedAt) { %>
                      <% 
                        const duration = incident.resolvedAt - incident.startedAt;
                        const minutes = Math.floor(duration / 60000);
                        const hours = Math.floor(minutes / 60);
                      %>
                      <%= hours > 0 ? hours + 'h ' : '' %><%= minutes % 60 %>m
                    <% } else { %>
                      <span class="text-danger">Ongoing</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <script src="/script.js"></script>
</body>
</html>
