<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ApexMonitor Admin</title>
  <link rel="stylesheet" href="https://unpkg.com/light-icons/dist/light-icon.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/admin" class="navbar-brand">
        <i class="light-icon-activity"></i>
        <span>Apex</span>Monitor
      </a>
      <div class="navbar-nav" id="navbarNav">
        <a href="/admin" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
          <i class="light-icon-grid"></i>
          <span>Dashboard</span>
        </a>
        <a href="/admin/incidents" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'incidents' ? 'active' : '' %>">
          <i class="light-icon-alert-triangle"></i>
          <span>Incidents</span>
        </a>
        <a href="/admin/settings" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'active' : '' %>">
          <i class="light-icon-settings"></i>
          <span>Settings</span>
        </a>
        <a href="/" target="_blank" class="nav-link">
          <i class="light-icon-external-link"></i>
          <span>Status Page</span>
        </a>
        <div class="nav-divider"></div>
        <button class="theme-toggle" id="themeToggle" title="Toggle dark mode">
          <i class="light-icon-moon"></i>
          <i class="light-icon-sun"></i>
        </button>
        <div class="user-dropdown" id="userDropdown">
          <button class="user-dropdown-toggle" id="userDropdownToggle">
            <img src="https://www.gravatar.com/avatar/<%= typeof gravatarHash !== 'undefined' ? gravatarHash : '00000000000000000000000000000000' %>?s=32&d=identicon" alt="Avatar" class="user-avatar">
            <span class="user-name"><%= username %></span>
            <i class="light-icon-chevron-down"></i>
          </button>
          <div class="user-dropdown-menu" id="userDropdownMenu">
            <div class="dropdown-header">
              <img src="https://www.gravatar.com/avatar/<%= typeof gravatarHash !== 'undefined' ? gravatarHash : '00000000000000000000000000000000' %>?s=64&d=identicon" alt="Avatar" class="dropdown-avatar">
              <div class="dropdown-user-info">
                <span class="dropdown-username"><%= username %></span>
                <span class="dropdown-role">Administrator</span>
              </div>
            </div>
            <div class="dropdown-divider"></div>
            <a href="/admin/settings#account" class="dropdown-item">
              <i class="light-icon-edit"></i>
              <span>Edit Profile</span>
            </a>
            <a href="/admin/settings" class="dropdown-item">
              <i class="light-icon-settings"></i>
              <span>Settings</span>
            </a>
            <div class="dropdown-divider"></div>
            <a href="/auth/logout" class="dropdown-item dropdown-item-danger">
              <i class="light-icon-log-out"></i>
              <span>Logout</span>
            </a>
          </div>
        </div>
      </div>
      <button class="navbar-toggle" id="navbarToggle">
        <i class="light-icon-menu"></i>
      </button>
    </div>
  </nav>

  <div class="container admin-content">
    <%- body %>
  </div>

  <script src="/script.js"></script>
</body>
</html>
