<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="refresh" content="60">
  <title><%= title %></title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      background-color: #0f172a;
      color: #e2e8f0;
      min-height: 100vh;
      line-height: 1.6;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    header {
      text-align: center;
      margin-bottom: 40px;
    }

    header h1 {
      font-size: 28px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .overall-status {
      display: inline-block;
      padding: 8px 20px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .overall-status.operational {
      background-color: rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .overall-status.degraded {
      background-color: rgba(234, 179, 8, 0.2);
      color: #eab308;
    }

    .overall-status.outage {
      background-color: rgba(239, 68, 68, 0.2);
      color: #ef4444;
    }

    .last-updated {
      font-size: 12px;
      color: #64748b;
    }

    .service-group {
      background-color: #1e293b;
      border-radius: 12px;
      margin-bottom: 20px;
      overflow: hidden;
    }

    .group-header {
      background-color: #334155;
      padding: 15px 20px;
      font-weight: 600;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .service-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 20px;
      border-bottom: 1px solid #334155;
    }

    .service-item:last-child {
      border-bottom: none;
    }

    .service-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .status-dot.operational {
      background-color: #22c55e;
      box-shadow: 0 0 10px rgba(34, 197, 94, 0.5);
    }

    .status-dot.degraded {
      background-color: #eab308;
      box-shadow: 0 0 10px rgba(234, 179, 8, 0.5);
    }

    .status-dot.down {
      background-color: #ef4444;
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
    }

    .status-dot.unknown {
      background-color: #64748b;
    }

    .service-name {
      font-weight: 500;
    }

    .service-meta {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 13px;
      color: #94a3b8;
    }

    .uptime-bar {
      display: flex;
      gap: 1px;
      height: 24px;
    }

    .uptime-bar .bar {
      width: 3px;
      border-radius: 1px;
      transition: background-color 0.2s;
    }

    .uptime-bar .bar.up {
      background-color: #22c55e;
    }

    .uptime-bar .bar.down {
      background-color: #ef4444;
    }

    .uptime-bar .bar.empty {
      background-color: #334155;
    }

    .response-time {
      min-width: 60px;
      text-align: right;
    }

    .uptime-percent {
      min-width: 70px;
      text-align: right;
      font-weight: 500;
    }

    .uptime-percent.good {
      color: #22c55e;
    }

    .uptime-percent.warning {
      color: #eab308;
    }

    .uptime-percent.bad {
      color: #ef4444;
    }

    .incidents-section {
      margin-top: 40px;
    }

    .incidents-section h2 {
      font-size: 18px;
      margin-bottom: 20px;
      font-weight: 600;
    }

    .incident-list {
      background-color: #1e293b;
      border-radius: 12px;
      overflow: hidden;
    }

    .incident-item {
      padding: 15px 20px;
      border-bottom: 1px solid #334155;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .incident-item:last-child {
      border-bottom: none;
    }

    .incident-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .incident-status {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .incident-status.active {
      background-color: rgba(239, 68, 68, 0.2);
      color: #ef4444;
    }

    .incident-status.resolved {
      background-color: rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .incident-service {
      font-weight: 500;
    }

    .incident-time {
      font-size: 12px;
      color: #64748b;
    }

    .no-incidents {
      padding: 30px;
      text-align: center;
      color: #64748b;
    }

    footer {
      text-align: center;
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #334155;
      font-size: 12px;
      color: #64748b;
    }

    footer a {
      color: #667eea;
      text-decoration: none;
    }

    footer a:hover {
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      .service-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }

      .service-meta {
        width: 100%;
        justify-content: space-between;
      }

      .uptime-bar .bar {
        width: 2px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>System Status</h1>
      <div class="overall-status <%= overallStatus %>">
        <% if (overallStatus === 'operational') { %>
          All Systems Operational
        <% } else if (overallStatus === 'degraded') { %>
          Partial System Outage
        <% } else { %>
          Major System Outage
        <% } %>
      </div>
      <div class="last-updated">
        Last updated: <%= lastUpdated.toLocaleString() %>
      </div>
    </header>

    <main>
      <% Object.entries(groupedServices).forEach(([group, services]) => { %>
        <section class="service-group">
          <div class="group-header"><%= group %></div>
          <% services.forEach(service => { %>
            <div class="service-item">
              <div class="service-info">
                <span class="status-dot <%= service.status %>"></span>
                <span class="service-name"><%= service.name %></span>
              </div>
              <div class="service-meta">
                <div class="uptime-bar" title="Last 90 checks">
                  <% for (let i = 0; i < 90; i++) { %>
                    <% const check = service.recentChecks[i]; %>
                    <div class="bar <%= check ? (check.status === 'UP' ? 'up' : 'down') : 'empty' %>"></div>
                  <% } %>
                </div>
                <span class="response-time">
                  <% if (service.responseTime !== null) { %>
                    <%= service.responseTime %>ms
                  <% } else { %>
                    -
                  <% } %>
                </span>
                <span class="uptime-percent <%= parseFloat(service.uptimePercent) >= 99 ? 'good' : (parseFloat(service.uptimePercent) >= 95 ? 'warning' : 'bad') %>">
                  <%= service.uptimePercent %>%
                </span>
              </div>
            </div>
          <% }); %>
        </section>
      <% }); %>

      <% if (Object.keys(groupedServices).length === 0) { %>
        <section class="service-group">
          <div class="no-incidents">No services configured for status page</div>
        </section>
      <% } %>

      <section class="incidents-section">
        <h2>Recent Incidents</h2>
        <div class="incident-list">
          <% if (recentIncidents.length > 0) { %>
            <% recentIncidents.forEach(incident => { %>
              <div class="incident-item">
                <div class="incident-info">
                  <span class="incident-status <%= incident.isActive ? 'active' : 'resolved' %>">
                    <%= incident.isActive ? 'Active' : 'Resolved' %>
                  </span>
                  <span class="incident-service"><%= incident.serviceName %></span>
                </div>
                <span class="incident-time">
                  <%= incident.startedAt.toLocaleString() %>
                  <% if (incident.resolvedAt) { %>
                    → <%= incident.resolvedAt.toLocaleString() %>
                  <% } %>
                </span>
              </div>
            <% }); %>
          <% } else { %>
            <div class="no-incidents">No recent incidents</div>
          <% } %>
        </div>
      </section>
    </main>

    <footer>
      Powered by <a href="https://github.com/apexmonitor/apexmonitor">ApexMonitor</a>
      &nbsp;|&nbsp;
      <a href="/auth/login">Admin</a>
    </footer>
  </div>
</body>
</html>
