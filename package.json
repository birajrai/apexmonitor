{
  "name": "apexmonitor",
  "version": "1.0.0",
  "description": "Self-hosted uptime monitoring system with status page",
  "main": "dist/app.js",
  "scripts": {
    "build": "npm run build:sass && tsc && npm run copy-assets",
    "build:sass": "sass src/scss/style.scss src/public/style.css --style compressed --no-source-map",
    "watch:sass": "sass src/scss/style.scss src/public/style.css --watch",
    "copy-assets": "node -e \"const fs=require('fs');const path=require('path');function copyDir(s,d){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>{const sp=path.join(s,f),dp=path.join(d,f);fs.statSync(sp).isDirectory()?copyDir(sp,dp):fs.copyFileSync(sp,dp)})};copyDir('src/views','dist/views');copyDir('src/public','dist/public')\"",
    "start": "node dist/app.js",
    "dev": "npm run build:sass && ts-node src/app.ts",
    "dev:watch": "concurrently \"npm run watch:sass\" \"ts-node src/app.ts\""
  },
  "keywords": [
    "uptime",
    "monitoring",
    "status-page"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "ping": "^0.4.4",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.10.5",
    "sass": "^1.97.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
