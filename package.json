{
  "name": "apexmonitor",
  "version": "1.0.0",
  "description": "Self-hosted uptime monitoring system with status page",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && npm run copy-views",
    "copy-views": "node -e \"const fs=require('fs');const path=require('path');function copyDir(s,d){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>{const sp=path.join(s,f),dp=path.join(d,f);fs.statSync(sp).isDirectory()?copyDir(sp,dp):fs.copyFileSync(sp,dp)})};copyDir('src/views','dist/views')\"",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts"
  },
  "keywords": ["uptime", "monitoring", "status-page"],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mongoose": "^8.0.3",
    "ping": "^0.4.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.10.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
